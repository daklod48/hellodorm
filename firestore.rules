rules_version = '2';

// HelloDorm Firestore security rules (one project for v1, v2 and v3).
// Paste into Firebase console > Firestore Database > Rules > Publish.
// EDIT: the manager list in isManager() holds Firebase user IDs (UIDs). It must match MANAGER_UIDS in v2/config.js and v3/config.js.
// How to read a UID and where to paste it: HOW-IT-WORKS.md section 15.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Managers are listed by Firebase user ID (UID), the random account number Firebase gives every account.
    // A UID cannot be claimed by signing up with someone's email, so no email check is needed (security fix 2026-11-06,
    // replacing the email list). Every manager permission below goes through here.
    // EDIT: one quoted UID per manager, separated by commas. Currently one manager (the owner), set 2026-11-07.
    function isManager() {
      return signedIn() && request.auth.uid in [
        'H4LqAN23sfewbZYZekVs0Jb7KS62'
      ];
    }

    // Prototype clock offset (manager "skip ahead 15 days"), in milliseconds.
    function offsetMs() {
      return exists(/databases/$(database)/documents/config/clock)
        ? get(/databases/$(database)/documents/config/clock).data.offsetDays * 86400000
        : 0;
    }

    // Test data: demo copies (anonymous accounts) and the automated test accounts named tester-...@hellodorm-demo.test.
    function isTestProfile(d) {
      return d.get('isDemo', false) == true || (d.get('email', '') >= 'tester-' && d.get('email', '') < 'tester.');
    }
    function isTestUser(uid) {
      return isTestProfile(get(/databases/$(database)/documents/users/$(uid)).data);
    }

    // Each user reads and writes only their own profile and sub-collections
    // (items they submitted, orders, notifications).
    // Managers may also find and delete test data (see tools/cleanup-test-data.py), nothing else.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      allow list: if isManager() && (resource.data.isDemo == true || (resource.data.email >= 'tester-' && resource.data.email < 'tester.'));
      allow get, delete: if isManager() && isTestProfile(resource.data);
      match /{sub=**} {
        allow read, write: if signedIn() && request.auth.uid == uid;
        allow list, get, delete: if isManager() && isTestUser(uid);
      }
    }

    // Managers can read every submitted item and set a price or reject it.
    match /{path=**}/items/{itemId} {
      allow read, update: if isManager();
    }

    // Shop catalogue state (reserved / sold) for the 30 sample items: anyone can read.
    // A signed-in user may reserve an item that is free, or whose 48-hour hold has run out.
    match /shop/{itemId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.keys().hasOnly(['status', 'by', 'until']);
      allow update: if isManager() || (signedIn()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.keys().hasOnly(['status', 'by', 'until'])
        && (resource.data.by == request.auth.uid
            || (resource.data.status == 'reserved' && resource.data.until < request.time.toMillis() + offsetMs())));
      allow delete: if isManager() || (signedIn() && resource.data.by == request.auth.uid);
    }

    // ---------- v3 round 6 (8 Nov 2026): accepted items go on sale at once, leaderboard ----------
    // Resale price table (CZK) for automatic offers and donations. It must match standardResale() in v3/data/prices.js
    // (new price x condition factor x 50 %, rounded to 10). Regenerate both together if prices change.
    function resaleTable() {
      return { 'kitchen_likenew': 350, 'kitchen_good': 260, 'kitchen_used': 180, 'textiles_likenew': 400, 'textiles_good': 300, 'textiles_used': 200, 'electronics_likenew': 450, 'electronics_good': 340, 'electronics_used': 230, 'furniture_likenew': 750, 'furniture_good': 560, 'furniture_used': 380, 'clothes_likenew': 600, 'clothes_good': 450, 'clothes_used': 300, 'study_likenew': 300, 'study_good': 230, 'study_used': 150, 'other_likenew': 250, 'other_good': 190, 'other_used': 130 };
    }
    function listingShape(d) {
      return d.keys().hasOnly(['title', 'desc', 'cat', 'cond', 'dorm', 'price', 'newPrice', 'photo', 'listedAt', 'kw', 'seller', 'item', 'demo'])
        && d.title is map && d.desc is map && d.cat is string && d.cond is string
        && d.price is number && d.price > 0 && d.price <= 100000
        && d.dorm is string && d.dorm.size() <= 20 && d.listedAt is number
        && (!('photo' in d) || (d.photo is string && d.photo.size() < 210000));
    }
    function itemOf(id) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)/items/$(id)).data;
    }

    // Sale price a manager sets at the offer step (or changes later). Only managers write; anyone reads.
    match /salePrices/{listingId} {
      allow read: if true;
      allow create, update: if isManager() && request.resource.data.keys().hasOnly(['price', 'at'])
        && request.resource.data.price is number && request.resource.data.price > 0;
      allow delete: if isManager();
    }

    // Items on sale again (bought from a student or donated). Listing id = <seller uid>_<item id>.
    // A seller's own app creates it once, the moment their item is accepted or donated, and only at the price a manager
    // set (salePrices) or, without one, the table price; it cannot change it afterwards. Managers create, change, delete.
    // A Demo account's listing carries demo: true (the app shows it only to that demo copy), and only it may delete it.
    match /listings/{listingId} {
      allow read: if true;
      allow create, update: if isManager() && listingShape(request.resource.data);
      allow create: if signedIn() && listingShape(request.resource.data)
        && request.resource.data.seller == request.auth.uid
        && request.resource.data.item is string
        && listingId == request.auth.uid + '_' + request.resource.data.item
        && request.resource.data.demo == (request.auth.token.firebase.sign_in_provider == 'anonymous')
        && itemOf(request.resource.data.item).status in ['accepted', 'donated']
        && itemOf(request.resource.data.item).cat == request.resource.data.cat
        && itemOf(request.resource.data.item).cond == request.resource.data.cond
        && request.resource.data.price == (exists(/databases/$(database)/documents/salePrices/$(listingId))
             ? get(/databases/$(database)/documents/salePrices/$(listingId)).data.price
             : resaleTable()[request.resource.data.cat + '_' + request.resource.data.cond]);
      allow delete: if isManager() || (signedIn() && resource.data.seller == request.auth.uid && resource.data.demo == true);
    }

    // Leaderboard: one small public entry per account, written only by its owner (never by anonymous demo accounts),
    // with only these fields. The profile photo is a WebP of at most 50 KB (about 68,000 characters as text).
    match /leaderboard/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.keys().hasOnly(['name', 'avatar', 'kg', 'items', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.avatar is string && request.resource.data.avatar.size() <= 70000
        && request.resource.data.kg is number && request.resource.data.kg >= 0 && request.resource.data.kg <= 10000
        && request.resource.data.items is int && request.resource.data.items >= 1 && request.resource.data.items <= 1000
        && request.resource.data.at is number;
      allow delete: if signedIn() && (request.auth.uid == uid || isManager());
    }
    // Avatars a manager has hidden from the leaderboard (unsuitable photos). Anyone reads; only managers write.
    match /lbHide/{uid} {
      allow read: if true;
      allow write: if isManager();
    }

    // Prototype settings (clock): anyone reads, only managers change.
    match /config/{docId} {
      allow read: if true;
      allow write: if isManager();
    }

    // Waitlist: anyone can add an entry (launch list, or "ask for a stand" with a typed dorm name); only managers can read.
    match /waitlist/{entryId} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'dorm', 'dormName', 'lang', 'at'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && (!('dormName' in request.resource.data) || (request.resource.data.dormName is string && request.resource.data.dormName.size() <= 120));
      allow read: if isManager();
    }

    // Counters (visits and key taps, no personal data): anyone can add exactly 1; only managers read.
    match /stats/{name} {
      allow create: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == 1;
      allow update: if request.resource.data.keys().hasOnly(['n']) && request.resource.data.n == resource.data.n + 1;
      allow read: if isManager();
    }
  }
}
